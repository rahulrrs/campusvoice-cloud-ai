[Unit]
Description=CampusVoice API Docker Compose stack from ECR
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/online_complaint_system/backend
ExecStart=/bin/sh -lc '/usr/bin/docker compose pull api && /usr/bin/docker compose up -d'
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
